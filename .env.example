# Express API
PORT=4000
CORS_ORIGIN=http://localhost:3000

# MySQL (matches docker-compose.yml defaults)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=agentflow
DB_PASSWORD=agentflow_dev_password
DB_NAME=agentflow

# Optional OpenAI-compatible Chat Completions API. Leave empty for mock responses.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Next.js frontend
NEXT_PUBLIC_API_URL=http://localhost:4000/api
